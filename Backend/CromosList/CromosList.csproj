<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UserSecretsId>98f10815-cee3-4da3-9e9f-629836630d08</UserSecretsId>
		<AngularProjectPath>$(MSBuildProjectDirectory)\..\..\Frontend\CromosList</AngularProjectPath>		<AngularDistPath>$(AngularProjectPath)\dist\CromosList\browser</AngularDistPath>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.9" />
		<PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.9" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
		<PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
	</ItemGroup>

	<ItemGroup>
		<Folder Include="Controllers\" />
		<Folder Include="wwwroot\" />
	</ItemGroup>

<Target Name="BuildAngular" BeforeTargets="Build"
		  Condition="Exists('$(AngularProjectPath)\package.json') And '$(SkipAngularBuild)' != 'true' And '$(BuildAngular)' == 'true'">
		<Exec
		  WorkingDirectory="$(AngularProjectPath)"
		  Command="npm ci"
		  Condition="!Exists('$(AngularProjectPath)\node_modules')"
		  ContinueOnError="WarnAndContinue" />

		<Exec
		  WorkingDirectory="$(AngularProjectPath)"
		  Command="npm run build"
		  ContinueOnError="WarnAndContinue" />

		<ItemGroup>
			<AngularFiles Include="$(AngularDistPath)\**\*" />
		</ItemGroup>

		<Copy
		  SourceFiles="@(AngularFiles)"
		  DestinationFiles="@(AngularFiles->'$(MSBuildProjectDirectory)\wwwroot\%(RecursiveDir)%(Filename)%(Extension)')" />
	</Target>

	<Target Name="AvisarAngularNoCompilado" BeforeTargets="Build"
		  Condition="Exists('$(AngularProjectPath)\package.json') And '$(SkipAngularBuild)' != 'true' And '$(BuildAngular)' != 'true'">
		<Message Importance="high" Text="Angular NO se ha compilado en este build (solo afecta a wwwroot). En desarrollo usa '.\dev.cmd' (ng serve en http://localhost:4200 con recarga en caliente). Para incluirlo en el build: -p:BuildAngular=true" />
	</Target>

</Project>
